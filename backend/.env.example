# Database Configuration (Local PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=epic_command
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/epic_command

# Server Host & Port
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Authentication & Security
JWT_SECRET=epic_command_dev_jwt_key_change_in_prod
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SMTP Email Settings (AWS SES)
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=YOUR_SMTP_USER
SMTP_PASS=YOUR_SMTP_PASS
SMTP_FROM_NAME=EPIC Command
SMTP_FROM_EMAIL=no-reply@example.com

# MediaMTX Streaming Engine Paths & URLs
MEDIAMTX_API_URL=http://127.0.0.1:9997
MEDIAMTX_WHEP_URL=http://127.0.0.1:8889
MEDIAMTX_RTSP_URL=rtsp://127.0.0.1:8554
MEDIAMTX_WEBRTC_PORT=8889
MEDIAMTX_HLS_PORT=8888
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_API_PORT=9997
